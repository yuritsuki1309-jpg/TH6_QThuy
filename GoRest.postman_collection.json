  "item": [
    {
      "name": "Positives_Cases",
      "item": [
        {
          "name": "Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\nvar jsonData=  pm.response.json()\r\n\r\nif (jsonData.id) {\r\n    pm.environment.set(\"userID\", jsonData.id);\r\n    console.log(\"Đã Lưu User ID: \"+ jsonData.id)\r\n}"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.variables.get(\"name\")) {\r\n\r\n    const users = [\r\n        {\r\n            name: \"Nguyen Van A\",\r\n            gender: \"male\",\r\n            email: `nguyenvana_${Date.now()}@gmail.com`,\r\n            status: \"active\"\r\n        },\r\n        {\r\n            name: \"Tran Thi B\",\r\n            gender: \"female\",\r\n            email: `tranthib_${Date.now()}@gmail.com`,\r\n            status: \"active\"\r\n        },\r\n        {\r\n            name: \"Le Van C\",\r\n            gender: \"male\",\r\n            email: `levanc_${Date.now()}@gmail.com`,\r\n            status: \"inactive\"\r\n        }\r\n    ];\r\n\r\n    const user = users[0];\r\n\r\n    pm.variables.set(\"name\", user.name);\r\n    pm.variables.set(\"gender\", user.gender);\r\n    pm.variables.set(\"email\", user.email);\r\n    pm.variables.set(\"status\", user.status);\r\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"name\": \"{{name}}\",\r\n    \"gender\": \"{{gender}}\",\r\n    \"email\": \"{{email}}\",\r\n    \"status\": \"{{status}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseurl}}/users",
              "host": [
                "{{baseurl}}"
              ],
              "path": [
                "users"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Check User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Correct User\", function () {\n    const data = pm.response.json();\n    pm.expect(data.id).to.eql(Number(pm.environment.get(\"userID\")));\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
